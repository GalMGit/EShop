{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Wolverine": "Warning",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "ConnectionStrings": {
    "IdentityDatabase": "Host=localhost;Port=5432;Database=eshop.identity;Username=username;Password=password",
    "CatalogDatabase": "Host=localhost;Port=5432;Database=eshop.catalog;Username=username;Password=password",
    "InventoryDatabase": "Host=localhost;Port=5432;Database=eshop.inventory;Username=username;Password=password",
    "CartDatabase": "Host=localhost;Port=5432;Database=eshop.cart;Username=username;Password=password",
    "RabbitMq": "amqp://guest:guest@localhost:5672",
    "Redis": "localhost:6379,password=mypassword,abortConnect=false"
  },
  "JwtOptions" : {
    "SecretKey": "",
    "Expires": "30"
  },
  "Elasticsearch": {
    "Url": "http://localhost:9200"
  },
  "Identity": {
    "Admin": {
      "Username": "",
      "Email": "",
      "Password": ""
    }
  }
}
